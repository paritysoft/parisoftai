# ─────────────────────────────────────────────────────────────────────────────
# ParitySoft AI — environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Development / Preview / Production). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (canonical URLs, sitemap, auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://parisoftai.com

# Supabase — Project Settings → API Keys.
# The publishable key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name also supported instead of the line above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Used for: storing contact-form leads, rate limiting,
# inviting admin users, and the bootstrap script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy name also supported instead of the line above:
# SUPABASE_SERVICE_ROLE_KEY=

# Safety guard: set this (in Preview/Development) to your PRODUCTION project ref
# (the "abcd1234" in https://abcd1234.supabase.co). If a non-production deployment
# is ever pointed at that project, all admin writes are refused.
SUPABASE_PRODUCTION_PROJECT_REF=

# Email notifications for new inquiries (Resend — https://resend.com).
# Leave empty to disable email; leads are still stored and visible in /admin/leads.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "ParitySoft AI <notifications@parisoftai.com>"
CONTACT_FROM_EMAIL=
# Fallback recipients (comma-separated) when none are set in /admin/settings
CONTACT_NOTIFICATION_EMAIL=

# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Optional: link to your Vercel Web Analytics page, shown in /admin/analytics
ANALYTICS_DASHBOARD_URL=
