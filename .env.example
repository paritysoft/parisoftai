# ─────────────────────────────────────────────────────────────────────────────
# ParitySoft AI — environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Development / Preview / Production). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (canonical URLs, sitemap, auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://parisoftai.com

# ─── Git-backed admin (used while Supabase is NOT configured) ───────────────────
# See docs/CONTENT_PUBLISHING.md. Leave empty to disable /admin entirely.
ADMIN_EMAIL=
# Generate with: npm run admin:hash-password   (never put the plain password here)
ADMIN_PASSWORD_HASH=
# 32+ random characters (printed by admin:hash-password)
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token: this repository only, "Contents: Read and write"
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=paritysoft/parisoftai
GITHUB_CONTENT_BRANCH=main
# Local testing only: let a production build (next start) save to ./content. Ignored on Vercel.
# CMS_FILESYSTEM_WRITES=true

# Optional public email shown on /contact (and used as a fallback if the form can't send).
CONTACT_PUBLIC_EMAIL=info@parisoftai.com

# ─── Supabase (optional — enables the full database CMS instead) ───────────────
# Supabase — Project Settings → API Keys.
# The publishable key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name also supported instead of the line above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Used for: storing contact-form leads, rate limiting,
# inviting admin users, and the bootstrap script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy name also supported instead of the line above:
# SUPABASE_SERVICE_ROLE_KEY=

# Safety guard: set this (in Preview/Development) to your PRODUCTION project ref
# (the "abcd1234" in https://abcd1234.supabase.co). If a non-production deployment
# is ever pointed at that project, all admin writes are refused.
SUPABASE_PRODUCTION_PROJECT_REF=

# Contact form via your mailbox (Zoho Mail): the form sends directly to SMTP_USER.
# SMTP_PASS = a Zoho "Application-Specific Password". Host defaults to Zoho (smtp.zoho.com / smtppro.zoho.com).
SMTP_USER=info@parisoftai.com
SMTP_PASS=
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465

# Alternative: contact-form delivery via Resend (https://resend.com, free tier is enough).
# Without Supabase these three are REQUIRED for the contact form to work: inquiries are emailed
# to CONTACT_NOTIFICATION_EMAIL (reply-to = the visitor). With Supabase, leads are also stored.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "ParitySoft AI <notifications@parisoftai.com>"
CONTACT_FROM_EMAIL=
# Fallback recipients (comma-separated) when none are set in /admin/settings
CONTACT_NOTIFICATION_EMAIL=

# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Optional: link to your Vercel Web Analytics page, shown in /admin/analytics
ANALYTICS_DASHBOARD_URL=
